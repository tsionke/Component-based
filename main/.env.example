# Fabric Telebirr Configuration Template
# Copy to .env and replace with your real credentials

FABRIC_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
FABRIC_APP_ID=your_fabric_app_id_here
FABRIC_APP_SECRET=your_app_secret_here
MERCHANT_APP_ID=your_merchant_app_id_here
MERCHANT_CODE=your_merchant_code_here

# RSA Private Key (PEM format - generate with openssl genrsa)
PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...
-----END PRIVATE KEY-----

# App Settings
NODE_ENV=development
ENABLE_DEBUG_LOGGING=true
PORT=3000

# Payment
CURRENCY=ETB
ORDER_TIMEOUT=120m

# Payee (update with yours)
PAYEE_IDENTIFIER=220311
PAYEE_IDENTIFIER_TYPE=04
PAYEE_TYPE=5000

# URLs (update for production)
NOTIFY_URL=http://localhost:3000/api/v1/notify
REDIRECT_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=*

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
